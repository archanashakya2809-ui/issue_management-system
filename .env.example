# Application
APP_NAME=Ticket Management API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Generate unique random values for your local .env file.
# Do not commit .env or reuse these example values in production.
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_SIGNING_KEY=replace-this-with-a-different-random-key-of-at-least-32-characters
ACCESS_TOKEN_KID=v1
ACCESS_TOKEN_ISSUER=ticketsys-api
ACCESS_TOKEN_AUDIENCE=ticketsys-web
ACCESS_TOKEN_MINUTES=10
ACCESS_TOKEN_PREVIOUS_SIGNING_KEYS={}
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=ticketsys_refresh
REFRESH_CSRF_COOKIE_NAME=ticketsys_refresh_csrf
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Existing PostgreSQL server running directly on this Windows machine.
# Keep port 5433 if that is the port used by your current PostgreSQL instance.
# URL-encode reserved characters in the password (for example: @, :, /, #, %).
DATABASE_URL=postgresql+psycopg://ticket_app:URL_ENCODED_PASSWORD@localhost:5433/ticket

# Browser development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional health-monitor ingestion. Leave empty unless explicitly configured.
HEALTH_INGEST_TOKEN=

# Private ticket attachment storage and upload limits.
ATTACHMENT_STORAGE_ROOT=./private_uploads
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_MAX_FILES_PER_TICKET=5

# and cannot be downloaded until a trusted scanner marks them clean.
